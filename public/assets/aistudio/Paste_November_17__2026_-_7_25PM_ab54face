2.2. Прототипы ключевых структур в TypeScript (концептуальный дизайн)
ENGINEERING PROPOSAL
/**
 * Результат вычисления предиката знака в многоуровневом NumericalDomain.
 * Гарантирует отсутствие ложного PASS при недостаточной точности.
 */
export type ExactSign = -1 | 0 | 1;

export type NumericConfidence =
  | 'LEVEL_1_FP64'
  | 'LEVEL_2_INTERVAL_CERTIFIED'
  | 'LEVEL_3_EXACT_SHEWCHUK'
  | 'LEVEL_3_EXACT_RATIONAL'
  | 'UNDETERMINED_OVERFLOW_OR_NAN';

export interface CertifiedPredicateResult {
  readonly sign: ExactSign | null; // null строго при невозможности определить знак
  readonly confidence: NumericConfidence;
  readonly escalated: boolean;
}

/**
 * Звуковой интервал IEEE-754 [lo, hi] с программным округлением наружу
 * (без зависимости от недоступного в JS fesetround).
 */
export interface Interval64 {
  readonly lo: number;
  readonly hi: number;
}

Принцип предотвращения ложного PASS при неопределённом результате:
 * При проверке в L7 верхняя граница интервала \overline{r} сравнивается с допуском:
   * если \overline{r} \le \varepsilon — аксиома гарантированно выполнена (PASS по данному предикату);
   * если \underline{r} > \varepsilon — аксиома гарантированно нарушена (FAIL по данному предикату);
   * если \underline{r} \le \varepsilon < \overline{r} (пограничная зона неопределённости интервала) — L7 обязан эскалировать вычисление на Level 3 (ExactRational над точными двоичными разложениями float64-координат). Если даже Level 3 не может завершить вычисление (например, из-за превышения бюджета разрядности BigInt или нечислового входа), L7 обязан вернуть UNDETERMINED, но никогда PASS.
